# ByteCode API — production environment.
# Install to /etc/bytecode/bytecode.env (chmod 640, owned root:bytecode).

# Bound to localhost only; nginx terminates TLS and proxies to it.
PORT=5000

# The frontend's origin. MUST be set: the default is "*", which would let any
# site on the internet drive this API.
CORS_ORIGINS=https://your-app.vercel.app

# Exactly one proxy (nginx) sits in front of the API. This must match reality:
# too low and every client shares one rate-limit bucket (nginx's own address);
# too high, or `true`, and a client can spoof X-Forwarded-For to mint itself a
# fresh bucket per request.
TRUST_PROXY_HOPS=1

# Execution limits
COMPILE_TIMEOUT_MS=15000
RUN_TIMEOUT_MS=10000
MAX_CODE_LENGTH=65536
MAX_STDIN_LENGTH=65536
MAX_OUTPUT_BYTES=65536

# Per-container resources. Peak host usage is roughly
# MAX_CONCURRENT_EXECUTIONS x SANDBOX_MEMORY, so size these against the VPS:
# the defaults below can want 4 x 256 MB = 1 GB on top of the OS and the API.
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=128
SANDBOX_USER=65534:65534

# Throttling
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_CONCURRENT_EXECUTIONS=4
MAX_QUEUED_EXECUTIONS=8
QUEUE_TIMEOUT_MS=15000

# Sandbox image names (built by backend/docker/build.sh)
IMAGE_PYTHON=bytecode-python
IMAGE_CPP=bytecode-cpp
IMAGE_JAVA=bytecode-java
