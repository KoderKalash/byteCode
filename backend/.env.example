# Server
PORT=5000
# Comma-separated allowed origins. Use your deployed frontend URL in production.
CORS_ORIGINS=http://localhost:3000

# Limits
MAX_CODE_LENGTH=65536
MAX_STDIN_LENGTH=65536
MAX_OUTPUT_BYTES=65536
COMPILE_TIMEOUT_MS=15000
RUN_TIMEOUT_MS=10000

# Per-IP request limit on /run-code
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Number of proxies in front of the app. 0 = none (trust the socket address).
# Never set this to `true`: a client could spoof X-Forwarded-For for a fresh bucket.
TRUST_PROXY_HOPS=0

# Concurrency cap. A request limit bounds how OFTEN clients ask; this bounds how
# many containers run AT ONCE, which is what actually caps memory and CPU use.
MAX_CONCURRENT_EXECUTIONS=4
MAX_QUEUED_EXECUTIONS=8
QUEUE_TIMEOUT_MS=15000

# Sandbox resources
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=128
SANDBOX_USER=65534:65534

# Image names (must match docker/build.sh)
IMAGE_PYTHON=bytecode-python
IMAGE_CPP=bytecode-cpp
IMAGE_JAVA=bytecode-java
